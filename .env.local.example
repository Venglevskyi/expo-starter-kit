# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — commit only this .example.

# ---------------------------------------------------------------------------
# Rebrand (set once when forking the template)
# ---------------------------------------------------------------------------
# Reverse-DNS prefix. Production uses this exactly; dev appends `.dev` to
# allow side-by-side install on the same device.
BUNDLE_PREFIX=com.expostarter.app

# Display name shown under the app icon.
APP_NAME=Expo Starter

# URL scheme for deep links and OAuth redirect. Must match the redirect URI
# authorized in Google Cloud Console: <APP_SCHEME>:/oauthredirect
APP_SCHEME=expo-starter-kit

# ---------------------------------------------------------------------------
# Build variant
# ---------------------------------------------------------------------------
# development | production
APP_VARIANT=development

# ---------------------------------------------------------------------------
# Google OAuth client IDs (filled in Step-3 — leave empty for Step-1)
# ---------------------------------------------------------------------------
# DEV_GOOGLE_WEB_CLIENT_ID=
# DEV_GOOGLE_IOS_CLIENT_ID=
# DEV_GOOGLE_ANDROID_CLIENT_ID=
#
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=
